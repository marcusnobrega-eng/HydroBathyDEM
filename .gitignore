# macOS / local clutter
.DS_Store
**/.DS_Store

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Large local DEM inputs
DEM_fabdem.tif
*.tif
*.tiff
*.vrt
*.ovr
*.aux.xml

# Vector/geospatial data products
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.geojson
*.kml
*.kmz

# Generated model outputs and diagnostics
Outputs/
/output/
/tmp/
examples/**/outputs/
examples/pune_catchment/data/pune_corrected_30m/manifest.json

# Downloaded/processed Lin et al. 2020 data artifacts
Data/Lin2020_bankfull_width/raw/
Data/Lin2020_bankfull_width/processed/
Data/Lin2020_bankfull_width/calibration/
Data/Lin2020_bankfull_width/calibration/*
Data/DEM/
Data/FABDEM_cache/
Data/FABDEM_tiles/

# Keep lightweight documentation in data folders
!Data/
!Data/Lin2020_bankfull_width/
!Data/Lin2020_bankfull_width/README.md
!Data/Lin2020_bankfull_width/calibration/
!Data/Lin2020_bankfull_width/calibration/README.md

# Archives and temporary pack/download files
*.zip
*.tar
*.tar.gz
*.tgz
*.tmp
tmp_*

# Tracked lightweight documentation and mini-case assets.
# Keep these exceptions at the end because gitignore uses the last match.
!docs/assets/*.png
!examples/
!examples/pune_catchment/
!examples/pune_catchment/README.md
!examples/pune_catchment/assets/
!examples/pune_catchment/assets/*.png
!examples/pune_catchment/configs/
!examples/pune_catchment/configs/*.json
!examples/pune_catchment/data/
!examples/pune_catchment/data/DEM_fabdem_pune.tif
!examples/pune_catchment/data/lin2020/
!examples/pune_catchment/data/lin2020/README.md
!examples/pune_catchment/data/lin2020/processed/
!examples/pune_catchment/data/lin2020/processed/*
!examples/pune_catchment/data/lin2020/calibration/
!examples/pune_catchment/data/lin2020/calibration/*
